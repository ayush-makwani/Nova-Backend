# ---------------------------------------------------------------------------
# Local environment configuration.
#
# Loaded by application.yml via `spring.config.import: optional:file:.env[...]`.
# Spring reads this as a .properties file, so the format is KEY=value - no
# `export` prefix, no shell quoting (quotes become part of the value), and no
# ${...} interpolation between entries.
#
# COMMITTED TEMPLATE - contains no real secrets. Copy to .env and fill in.
# Blank values below must be supplied before the matching feature works.
#
# Resolved relative to the working directory the app starts from, so run it
# from the project root. Real environment variables still win over this file.
# ---------------------------------------------------------------------------

# ---- Server ----
SERVER_PORT=8111

# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/nova?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
DB_NAME=nova
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=20000

# ---- JPA / Hibernate ----
# Use 'validate' in production once the schema is managed by migrations.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- Mail (Gmail + App Password) ----
# Not a normal account password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ---- JWT ----
# Base64 HMAC-SHA256 secret, >= 256 bits. Rotate for production.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=nova-app

# ---- Account lockout ----
ACCOUNT_LOCK_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# ---- MFA ----
MFA_ISSUER=NovaApp

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Rate limiting (login/signup/refresh) ----
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_TOKENS=10
RATE_LIMIT_REFILL_DURATION_MINUTES=1

# ---- Enterprise SSO (SAML) ----
SSO_SAML_ENABLED=false
SSO_SAML_AUTO_PROVISION=true
SSO_SAML_DEFAULT_ROLE=ROLE_USER
SSO_SAML_EMAIL_ATTRIBUTE=email
SSO_SAML_FULL_NAME_ATTRIBUTE=displayName
SSO_SAML_SUCCESS_REDIRECT_URI=http://localhost:3000/sso/callback
SSO_SAML_FAILURE_REDIRECT_URI=http://localhost:3000/sso/error

# ---- Companions ----
COMPANIONS_PRICE_PER_MONTH=89.00
COMPANIONS_MAX_QUANTITY=10
COMPANIONS_NAME_PREFIX=NOVA
COMPANIONS_DEFAULT_VOICE=Aoede
COMPANIONS_AUTO_JOIN_MEETINGS=true
COMPANIONS_SEND_MOM_AUTOMATICALLY=true
COMPANIONS_RESPOND_IN_VOICE=true
COMPANIONS_RECORD_MEETING_AUDIO=false
COMPANIONS_PAYMENT_ENABLED=false

# ---- Password reset ----
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_LINK_BASE_URL=http://localhost:3000/reset-password
# Leave blank to send as MAIL_USERNAME. Gmail rejects unverified From addresses.
PASSWORD_RESET_FROM_ADDRESS=

# ---- Team users ----
TEAM_USER_LOGIN_URL=http://localhost:3000/login

# ---- AWS / S3 ----
# Base64 AES-256 key encrypting AwsCredential.secretKey at rest.
# Generate with: openssl rand -base64 32
AWS_CREDENTIAL_ENCRYPTION_KEY=

# ---- Logging ----
LOG_DIR=logs
LOG_RETENTION_DAYS=3
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_APP=INFO

# ---- Docker build context (docker-compose.yml `app.build.context`) ----
# The app image is built from the Git repo rather than the local directory, so
# Compose needs credentials to clone it. Use a Personal Access Token with
# `repo` scope as GITHUB_TOKEN - not your account password.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_BRANCH=main
